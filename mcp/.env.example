DATABASE_URL=postgres://alsxaplus:CHANGE_ME@127.0.0.1:5432/alsxaplus
PORT=8081
# A long random string that only the web app and this server know. It lets the web app open a profile for a visitor.
SERVICE_KEY=CHANGE_ME
# Profiles that were not used for this many hours are deleted (the public demo keeps nothing for long).
PROFILE_TTL_HOURS=24
# Hosts the /mcp endpoint answers to (add the public name if /mcp is exposed).
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# The language model that orders the sentences. Leave the key unset to use the plain rules only.
# If the key is set, every other setting below must be set too.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# The inference profile id of your region group, for example us.anthropic.claude-haiku-5-5
BEDROCK_MODEL_ID=
BEDROCK_MONTHLY_LIMIT_USD=20
# The model's price per million tokens. A price that is too low weakens the limit.
BEDROCK_PRICE_INPUT_USD_PER_MTOK=
BEDROCK_PRICE_OUTPUT_USD_PER_MTOK=
# BEDROCK_TIMEOUT_SECONDS=20
